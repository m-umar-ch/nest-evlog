{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^evlog/nestjs$": "<rootDir>/mocks/evlog-nestjs.ts",
    "^evlog$": "<rootDir>/mocks/evlog.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
