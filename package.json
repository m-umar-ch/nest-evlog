{
  "name": "nest-evlog",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "pnpm --filter @nest-evlog/queues build && pnpm --filter @nest-evlog/job-logging build && pnpm --filter './apps/*' build",
    "build:api": "pnpm --filter @nest-evlog/api build",
    "build:clock": "pnpm --filter @nest-evlog/clock build",
    "build:worker": "pnpm --filter @nest-evlog/worker build",
    "start:api": "pnpm --filter @nest-evlog/api start:dev",
    "start:clock": "pnpm --filter @nest-evlog/clock start:dev",
    "start:worker": "pnpm --filter @nest-evlog/worker start:dev",
    "start:api:prod": "pnpm --filter @nest-evlog/api start:prod",
    "start:clock:prod": "pnpm --filter @nest-evlog/clock start:prod",
    "start:worker:prod": "pnpm --filter @nest-evlog/worker start:prod",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @nest-evlog/api test",
    "test:e2e": "pnpm --filter @nest-evlog/api test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@apollo/protobufjs"]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
